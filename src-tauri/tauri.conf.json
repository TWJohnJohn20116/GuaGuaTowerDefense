{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "瓜瓜塔防",
  "version": "1.2.0",
  "identifier": "com.guagua.towerdefense",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:15173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "瓜瓜塔防",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["TradChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCNEM3NzBGM0RFNkZEQjYKUldTMi9lWTlEM2RNNnhVaG5ZaWJBRFZhVGUzOURDREE0bm4wRG11M1RIdWVDSHlQZmxPdEN3RWIK",
      "endpoints": [
        "https://github.com/TWJohnJohn20116/GuaGuaTowerDefense/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
